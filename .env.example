# =============================================================================
# Cloudreve-EO 环境变量示例
# 复制为 .env 后按需修改（.env 已被 git 忽略，勿提交真实密钥）
#
# 本地：edgeone makers env pull 也会生成/更新 .env
# 线上：edgeone makers env set <KEY> <VALUE>
#
# 说明：仅「基础设施」走环境变量。JWT 主密钥、S3 存储策略、每策略配额、
# 注册开关等业务配置一律在前端写入数据库，不在此配置。
# =============================================================================

# -----------------------------------------------------------------------------
# 服务端口
# - EdgeOne / Makers 运行时通常会注入 PORT，一般无需手写
# - config 默认：8080；api.go 入口未设置时回退 9000
# -----------------------------------------------------------------------------
PORT=8080

# -----------------------------------------------------------------------------
# 数据库
# DB_DRIVER: sqlite | postgres
# DB_DSN:
#   - sqlite：相对/绝对文件路径（EdgeOne 本地盘无状态，重部署可能清空）
#   - postgres：标准 DSN 连接串
# -----------------------------------------------------------------------------
DB_DRIVER=sqlite
DB_DSN=cloudreve.db

# --- PostgreSQL 示例（生产推荐）---
# DB_DRIVER=postgres
# DB_DSN=host=127.0.0.1 user=cloudreve password=secret dbname=cloudreve port=5432 sslmode=disable
#
# 云托管示例（ssl 常开）：
# DB_DSN=host=xxx.postgres.database.azure.com user=cloudreve password=xxx dbname=cloudreve port=5432 sslmode=require

# ---- SQLite 持久化（DB_DRIVER=sqlite 时有效）----
# 后端：local（默认，仅本地文件）/ s3（对象存储）/ github（GitHub 仓库）
DB_PERSIST=local
# 同步间隔（秒，最小 5），默认 60
#DB_PERSIST_INTERVAL=60

# ---- DB_PERSIST=s3 时必填/可选 ----
#DB_PERSIST_S3_BUCKET=
#DB_PERSIST_S3_ACCESS_KEY=
#DB_PERSIST_S3_SECRET_KEY=
# 自定义端点（MinIO/COS/R2 等），留空为 AWS 官方
#DB_PERSIST_S3_ENDPOINT=
#DB_PERSIST_S3_REGION=auto
#DB_PERSIST_S3_KEY=cloudreve.db
#DB_PERSIST_S3_PATH_STYLE=false

# ---- DB_PERSIST=github 时必填/可选（务必使用私有仓库）----
#DB_PERSIST_GITHUB_TOKEN=
#DB_PERSIST_GITHUB_REPO=owner/repo
#DB_PERSIST_GITHUB_BRANCH=main
#DB_PERSIST_GITHUB_PATH=cloudreve.db

# ---- DB_PERSIST=edgeone-blob 时必填/可选 ----
# 共享密钥：Go 主程序与 Node 云函数 db-blob.js 校验 /db-blob 请求用，取随机长字符串，必填
# DB_PERSIST_EDGEONE_SECRET=
# 可选：站点地址。留空时由首个请求的 Host 头自动推导，一般无需配置
# DB_PERSIST_EDGEONE_BASE_URL=